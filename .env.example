# Server-only Zapier destinations. Configure these in the deployment platform;
# never prefix them with NEXT_PUBLIC_ and never commit real hook URLs.
LEAD_WEBHOOK_SEO_URL="<server-only SEO Zapier catch-hook URL>"
LEAD_WEBHOOK_DIRECT_URL="<server-only direct-traffic Zapier catch-hook URL>"
LEAD_WEBHOOK_SMS_URL="<server-only SMS Zapier catch-hook URL>"
LEAD_WEBHOOK_FACEBOOK_URL="<server-only Facebook Zapier catch-hook URL>"
LEAD_WEBHOOK_UNKNOWN_FALLBACK_URL="<server-only fallback Zapier catch-hook URL>"

# Meta Pixel / Conversions API. The pixel id is intentionally public; the CAPI
# token is server-only. META_TEST_EVENT_CODE is optional outside verification.
NEXT_PUBLIC_META_PIXEL_ID="<Meta pixel id>"
META_CAPI_ACCESS_TOKEN="<server-only Meta CAPI access token>"
META_TEST_EVENT_CODE="<optional Meta test event code>"
